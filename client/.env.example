# Storefront calls go straight to the API from the browser.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Server-side only: the admin console is proxied here (see next.config.ts).
API_ORIGIN=http://localhost:5000
# Public URL of the storefront (sitemap, canonical links, share images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Extra image hosts next/image may optimise (comma-separated), e.g. a CDN for product photos.
# NEXT_PUBLIC_IMAGE_HOSTS=cdn.example.com
