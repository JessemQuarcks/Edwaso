PORT=5000
NODE_ENV=development
# Add ?directConnection=true when pointing at a single-node replica set
# (e.g. the mongodb-atlas-local Docker image), otherwise the driver tries to
# resolve the container's internal hostname and fails with ENOTFOUND.
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce?directConnection=true
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts admin 2FA secrets at rest. Must decode to exactly 32 bytes. Changing it
# invalidates every enrolled authenticator (reset with `npm run admin -- reset-2fa`).
DATA_ENCRYPTION_KEY=DATA_ENCRYPTION_KEY=L5eGRcgJ+8Pw+L/oLVC5cpDPJgiDC8woLtnjR2y0G4U=
# The storefront origin. Admin API writes must come from this exact origin.
CLIENT_URL=http://localhost:3000
# Which proxies to trust for the client IP (Express `trust proxy`). `loopback` trusts the
# Next.js dev server's proxy; in production set it to your load balancer's hop count or CIDR.
TRUST_PROXY=loopback

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:5000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx
