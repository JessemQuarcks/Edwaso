PORT=5000
NODE_ENV=development
# Add ?directConnection=true when pointing at a single-node replica set
# (e.g. the mongodb-atlas-local Docker image), otherwise the driver tries to
# resolve the container's internal hostname and fails with ENOTFOUND.
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce?directConnection=true
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:3000

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:5000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx
